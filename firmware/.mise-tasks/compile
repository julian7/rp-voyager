#!/usr/bin/env bash
#USAGE flag "-t --target <target>" help="compile target (eg. left or right)"
#USAGE flag "-z --zmkdir <zmkdir>" help="ZMK build environment"
#USAGE flag "-c --container-image <image>" help="Runs build under docker container"
#USAGE flag "-p --pristine" help="Pristine build"

set -eu

if [[ -z "${usage_target:-}" ]]; then
    mise compile -t left
    mise compile -t right
    exit 0
fi

: "${usage_zmkdir:=$HOME/src/zmk}"
config_base="config/rp_voyager_${usage_target}"

declare -a CMD=()
declare -a PARAMS=()

if [[ ! -e "${config_base}.conf" ]]; then
    echo "target ${usage_target} not found."
    exit 1
fi

# shellcheck source=/dev/null
[[ -f "${config_base}.env" ]] && source "${config_base}.env"

if [[ -z "${usage_container_image:-}" && ! -d ${usage_zmkdir} ]]; then
    echo "no ZMK directory found at $usage_zmkdir"
    exit 1
fi

mkdir -p "build"
if [[ -n "${usage_container_image:-}" ]]; then
    RP_VOYAGER_PATH="/src"
    CMD+=(docker run --rm -v "$PWD:$RP_VOYAGER_PATH" "$usage_container_image")
else
    RP_VOYAGER_PATH="$PWD"
    cd "$usage_zmkdir"
fi

if [[ -n "${SNIPPET:-}" ]]; then
    PARAMS+=(--snippet "$SNIPPET")
fi

if [[ "${usage_pristine:-}" ]]; then
    PARAMS+=(--pristine)
fi

"${CMD[@]}" uv run west build --source app --board "rp_voyager_${usage_target}/rp2350a/m33" \
    "${PARAMS[@]}" \
    --build-dir "${RP_VOYAGER_PATH}/build/${usage_target}" \
    -- \
    -DZEPHYR_TOOLCHAIN_VARIANT="${ZEPHYR_TOOLCHAIN_VARIANT:-zephyr}" \
    -DZMK_EXTRA_MODULES="${RP_VOYAGER_PATH}" \
    -DZMK_CONFIG="${RP_VOYAGER_PATH}/config" \
    -DKEYMAP_FILE="${RP_VOYAGER_PATH}/config/rp_voyager.keymap"

if [[ -n "${usage_container_image:-}" ]]; then
    "${CMD[@]}" chown -R "$(id -u):$(id -g)" "${RP_VOYAGER_PATH}/build/${usage_target}"
fi
