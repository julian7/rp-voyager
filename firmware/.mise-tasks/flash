#!/usr/bin/env bash
#USAGE flag "-t --target <target>" help="compile target (eg. left or right)"
#USAGE flag "-m --mountpoint <dir>" help="upload firmware to this mount point when becomes available"

set -eu

if [[ -z "${usage_target:-}" ]]; then
    echo "set target to flash"
    exit 0
fi

: "${usage_mountpoint:=/Volumes/RP2350}"

echo "Waiting 30 sec to have $usage_mountpoint appear..."

function upload() {
    local target="${1%/}"
    local mountpoint="$2"
    local deadline=$((SECONDS + $3))
    local firmware="build/${target}/zephyr/zmk.uf2"

    test -e "$firmware" || {
        echo "firmware not found for target"
        return 1
    }
    while ! test -d "$mountpoint"; do
        ((SECONDS < deadline)) || {
            echo "Timed out waiting for $mountpoint" >&2
            return 1
        }
        sleep 1
    done
    echo "flashing..."
    cp "$firmware" "$mountpoint"
    echo "done."
}

upload "$usage_target" "$usage_mountpoint" 30
